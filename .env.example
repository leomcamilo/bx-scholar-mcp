# Required (free). Identifies you to the polite pools of OpenAlex, CrossRef and Unpaywall
POLITE_EMAIL=your@email.com

# Every key below is optional. The academic sources work without them, with lower limits,
# and their keys are free.

# OpenAlex (https://openalex.org/settings/api). Without it, requests count against
# a small daily budget shared by everyone on your IP.
OPENALEX_API_KEY=

# Semantic Scholar (https://www.semanticscholar.org/product/api#api-key-form): 5 req/s instead of 1
S2_API_KEY=

# OpenCitations (https://opencitations.net/accesstoken): higher rate limit
OPENCITATIONS_TOKEN=

# CORE (https://core.ac.uk/services/api). Search works without it;
# get_fulltext reads CORE's extracted text only with a key.
CORE_API_KEY=

# CiNii Research application ID (https://support.nii.ac.jp/en/cinii/api/developer)
CINII_APPID=

# Tavily web search (https://tavily.com), a paid service with a free monthly tier.
# The tavily source is skipped without it.
TAVILY_API_KEY=

# Only needed when running outside the repo (e.g. pip install).
# Inside the repo, .env and data/ are found at the root automatically.
# BX_SCHOLAR_HOME=/path/to/bx-scholar-mcp
# BX_SCHOLAR_DATA_DIR=data
