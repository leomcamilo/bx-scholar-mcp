# Required (free) — used for polite API pools
POLITE_EMAIL=your@email.com

# Optional — Tavily web search API
TAVILY_API_KEY=

# Optional — Semantic Scholar (free, get key at https://www.semanticscholar.org/product/api#api-key-form)
S2_API_KEY=

# Optional — only needed when running outside the repo (e.g. pip install).
# Inside the repo, .env and data/ are found at the root automatically.
# BX_SCHOLAR_HOME=/path/to/bx-scholar-mcp
# BX_SCHOLAR_DATA_DIR=data

# Optional — OpenAlex API key (free: https://openalex.org/settings/api). Without it,
# requests count against a small daily budget shared by everyone on your IP.
OPENALEX_API_KEY=
# Optional — OpenCitations (free token, raises rate limits: https://opencitations.net/accesstoken)
OPENCITATIONS_TOKEN=
# Optional — CORE (free key: https://core.ac.uk/services/api). Search works without it;
# get_fulltext reads CORE's extracted text only with a key.
CORE_API_KEY=
